{
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_ENTRYPOINT\" = cli ] && cat \"$CLAUDE_PLUGIN_ROOT/hooks/plan-rule.md\" \"$CLAUDE_PLUGIN_ROOT/hooks/next-step-rule.md\" \"$CLAUDE_PLUGIN_ROOT/hooks/sessions-rule.md\" || true"
          }
        ]
      }
    ]
  }
}
