{
  "manifest_version": 3,
  "name": "Claude chrome bridge",
  "version": "0.1.0",
  "description": "Comment on a page in Chrome and send the comment to the Claude Code session that owns the tab.",
  "key": "",
  "permissions": ["scripting", "nativeMessaging", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude chrome bridge"
  }
}
